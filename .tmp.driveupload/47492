    <main class="main-container">
        <section class="cart-page">
            <h2>Récapitulatif de votre commande</h2>

            <div class="cart-list" id="cart-items">
                <!-- Items rendered by cartManager -->
            </div>

            <div id="orderTypeContainer" class="order-type-container">
                <!-- Order type radio buttons injected by cart-manager.js -->
            </div>

            <div class="cart-summary" id="cartSummary">
                <div class="summary-line"><span>Sous-total</span><span id="subtotal">0 FC</span></div>
                <!-- <div class="summary-line"><span>Frais livraison</span><span id="delivery-fee">1.000 FC</span></div> -->
                <div class="summary-line total"><span>Total</span><span id="total-price">0 FC</span></div>
            </div>

            <div class="cart-actions">
                <!-- <button class="btn-pay" id="paymentBtn" onclick="cartManager.openPaymentModal()">Passer la commande</button> -->
                <button class="btn-whatsapp" onclick="cartManager.sendToWhatsApp()">PASSER LA COMMANDE</button>
            </div>
        </section>
    </main>

    <!-- Section QR Code -->
    <div class="qr-code-section">
        <button class="btn-qr-toggle" onclick="toggleQRCode()">📱 Afficher QR Code Menu</button>
        <div id="qrCodeContainer" class="qr-code-container hidden"></div>
    </div>
