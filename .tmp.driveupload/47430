/* style pour mobile uniquement */
@media screen and (max-width: 768px) {
    /* Force box-sizing et width pour tous les conteneurs */
    * {
        box-sizing: border-box;
    }
    
    .nav-container, .hero-content, .footer-content, .cart-container, .payment-modal {
        width: 100%;
    }
    
    /* Centre les textes du footer et des totaux du panier */
    .footer-section p, .footer-bottom p, .summary-line {
        text-align: center;
    }
    
    .nav-links {
        display: none;  /*cache le menu par defaut*/
        flex-direction: column;
        position: fixed; /*fixe le menu sur tout l'ecran*/
        top: 70px; /*ajuste selon la hauter de ton navbar*/
        left: 0;
        width: 100%;
        height: calc(100vh - 70px); /*prend toute la hauteur restante*/
        background-color: rgba(0, 0, 0, 0.95); /*fond sombre transparent*/
        text-align: center;
        padding-top: 50px;
        z-index: 1000;
        overflow-y: auto; /*ren la liste defilante si elle est longue*/
        
        /* cette classe sera ajoutee par le javascript au clic */
        .nav-links.active{
            display: flex !important;
            visibility: visible;
        }

        .nav-links li {
            margin: 20px 0; /* espace biien les liens pour les doigts */
        }

    }
    
}