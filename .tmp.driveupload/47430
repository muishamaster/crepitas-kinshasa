@media (max-width: 768px) {
    .hamburger {
        display: flex;
    }

    .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(15, 15, 15, 0.98);
        backdrop-filter: blur(10px);
        border-top: 1px solid var(--border-color);
        flex-direction: column;
        gap: 0;
        display: none;
        overflow: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        transition: var(--transition-smooth);
        z-index: 1000;
        padding: 0;
        margin: 0;
        align-items: flex-start;
    }

    .nav-links.active {
        display: flex !important;
        visibility: visible;
    }

    .nav-links li {
        width: 100%;
        border-bottom: 1px solid var(--border-color);
    }

    .nav-links a {
        display: block;
        padding: 1rem 2rem;
        font-size: 1rem;
        width: 100%;
        padding-bottom: 1rem;
        padding-top: 1rem;
    }

    /* Disable underline on mobile */
    .nav-links a::after {
        display: none;
    }

    /* Mobile hover: background color shift */
    .nav-links a:hover {
        background-color: rgba(212, 175, 55, 0.15);
        color: #D4AF37;
    }

    /* Mobile active: subtle background */
    .nav-links a.active {
        background-color: rgba(212, 175, 55, 0.1);
        color: #D4AF37;
        font-weight: 600;
    }
}
/* ======================== HERO SECTION ======================== */
.hero {
    height: 100vh;
    min-height: 600px;
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('img/baniere.jpeg') center / cover no-repeat fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, 
        rgba(0, 0, 0, 0.6) 0%, 
        rgba(15, 15, 15, 0.5) 50%, 
        rgba(0, 0, 0, 0.6) 100%);
    z-index: 1;
    backdrop-filter: blur(2px);
}
@media (max-width: 768px) {

    .hero-btns {
        display: flex;
        /* border-radius: 40px; */
        justify-content: center;
    }

    .btn-cta {
        padding: 8px 14px;     /* même padding que bouton QR */
        font-size: 14px;       /* même taille */
        width: auto;           /* largeur selon le texte */
        max-width: 200px;      /* limite propre */
        border-radius: 6px;
    }

}
.hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
    z-index: 1;
    animation: shimmer 8s ease-in-out infinite;
}

@keyframes shimmer {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(212,175,55,0.02)" stroke-width="1"/></pattern></defs><rect width="1200" height="600" fill="url(%23grid)"/></svg>');
    opacity: 0.3;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

