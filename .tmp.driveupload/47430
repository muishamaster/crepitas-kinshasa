    .nav-container {
        padding: 0 1rem;
    }

    .nav-links {
        display: none;
    }

    .logo h2 {
        font-size: 1.2rem;
    }

    .hero {
        height: 50vh;
    }

    .hero-title {
        font-size: 1.5rem;
    }

    .payment-options {
        grid-template-columns: 1fr;
    }
}

