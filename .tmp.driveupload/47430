/* Section QR */
.qr-code-section {
    display: flex;
    flex-direction: column;
    align-items: center;   /* centre horizontalement */
    justify-content: center;
    text-align: center;
    margin-top: 20px;
}

/* Bouton */
.btn-qr-toggle {
    padding: 10px 20px;
    font-size: 16px;
    border: none;
    border-radius: 8px;
    background-color: #2c3e50;
    color: white;
    cursor: pointer;
    transition: 0.3s ease;
}

.btn-qr-toggle:hover {
    background-color: #34495e;
}

/* Conteneur du QR Code */
.qr-code-container {
    margin-top: 20px;
    display: flex;
    justify-content: center; /* centre horizontalement */
    align-items: center;     /* centre verticalement si hauteur définie */
    width: 100%;
}

/* Si ton QR code est un canvas ou img */
.qr-code-container canvas,
.qr-code-container img {
    display: block;
    margin: 0 auto;
}

/* Classe pour cacher */
.hidden {
    display: none;
}

.btn-qr-toggle {
    padding: 8px 14px;       /* réduit l’espace interne */
    font-size: 14px;         /* texte un peu plus petit */
    border: none;
    border-radius: 6px;
    background-color: #2c3e50;
    color: white;
