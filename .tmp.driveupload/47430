/* ======================== VARIABLES GLOBALES ======================== */
:root {
    /* Couleurs permanentes */
    --gold: #C68E17;
    --gold-light: #D4A43A;
    --gold-underline: #D4AF37;
    
    /* Thème sombre (par défaut) */
    --bg: #0f0f0f;
    --bg-secondary: #1a1a1a;
    --bg-card: rgba(30, 30, 30, 0.95);
    --text: #e8e8e8;
    --text-secondary: #a0a0a0;
    --text-secondary-emphasis: #c0c0c0;
    --border: rgba(198, 142, 23, 0.2);
    --hover: rgba(198, 142, 23, 0.1);
    
    /* Legacy (compatibilité) */
    --dark-bg: #0f0f0f;
    --dark-secondary: #1a1a1a;
    --card-bg: rgba(30, 30, 30, 0.95);
    --text-light: #e8e8e8;
    --border-color: rgba(198, 142, 23, 0.2);
    --hover-bg: rgba(198, 142, 23, 0.1);
    
    /* Transitions et ombres */
    --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.6);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.4);
    --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.2);
}

/* ======================== THÈME CLAIR ======================== */
