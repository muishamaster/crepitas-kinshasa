.hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: 1px;
    color: #ffffff;
}

.hero-subtitle {
    color: var(--gold);
    display: block;
    font-size: 0.8em;
    font-weight: 700;
    margin-top: 0.5rem;
}

.hero-description {
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 2rem;
    font-weight: 300;
}

.hero-btns {
    display: flex;
    gap: 1.5rem;
    /* border-radius: 40px; */
    justify-content: center;
    flex-wrap: wrap;
}

/* ======================== CTA BUTTONS ======================== */
.btn-cta {
    padding: 1rem 2.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    overflow: hidden;
}

.btn-cta::before {
    content: '';
    /* position: absolute; */
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transition: var(--transition-smooth);
}

.btn-cta:hover::before {
    left: 100%;
}

.btn-cta-primary {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: #0f0f0f;
    /* border-radius: 50px; */
    /* box-shadow: 0 10px 40px rgba(212, 175, 55, 0.3); */
}

.btn-cta-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 50px rgba(212, 175, 55, 0.5);
}

.btn-cta-secondary {
    background: transparent;
    color: var(--gold);
    border: 2px solid var(--gold);
}

.btn-cta-secondary:hover {
    background: var(--hover-bg);
    transform: translateY(-3px);
}

/* ======================== PAYMENT BAR ======================== */
.payment-bar {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 2rem;
}

.payment-content {
    max-width: 1400px;
    margin: 0 auto;
}

.payment-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--gold);
    letter-spacing: 1.5px;
    margin-bottom: 1.5rem;
    text-align: center;
}

.payment-methods {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
    text-align: center; /* ensure labels center under icons */
}

/* payement method */

.payment-methods {
    display: flex;
    justify-content: center;
    gap: 30px;
}

.payment-icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: 2px solid #f1c40f;
    overflow: hidden; /* IMPORTANT */
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #1a1a1a;
}

.payment-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;   /* Remplit totalement le cercle */
}

.payment-method {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: 0.8;
    transition: var(--transition-smooth);
}

.payment-method:hover {
    opacity: 1;
    transform: scale(1.05);
}

.payment-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    background: rgba(212, 175, 55, 0.1);
    border: 2px solid var(--gold);
}

.payment-icon.mpesa::before { content: '📱'; }
.payment-icon.airtel::before { content: '📱'; }
.payment-icon.orange::before { content: '📱'; }

.payment-method span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-light);
}

/* ======================== MAIN LAYOUT ======================== */
.main-container {
    display: grid;
    /* grid-template-columns: 1fr 360px; */
    max-width: 1400px;
    margin: 4rem auto;
    gap: 2.5rem;
    padding: 0 2rem;
}

@media (max-width: 1024px) {
    .main-container {
        grid-template-columns: 1fr;
    }
}

/* ======================== MENU SECTION ======================== */
.menu-section {
    animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.menu-header {
    margin-bottom: 2.5rem;
}

.menu-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--text-light);
    margin-bottom: 0.5rem;
}

.menu-header p {
    color: var(--text-secondary);
    font-size: 1rem;
}

/* ======================== CATEGORY TABS ======================== */
.category-tabs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
}

.category-btn {
    padding: 1rem;
    background: var(--card-bg);
    border: 2px solid var(--border-color);
    border-radius: 12px;
    color: var(--text-light);
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
}

.category-btn .icon {
    font-size: 1.5rem;
}

.category-btn:hover {
    background: var(--hover-bg);
    border-color: var(--gold);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.2);
}

.category-btn.active {
    background: var(--gold);
    color: var(--dark-bg);
    border-color: var(--gold);
}

/* ======================== PRODUCT CARDS ======================== */
.product-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
}

@media (max-width: 768px) {
    .product-list {
        grid-template-columns: 1fr;
    }
}

.product-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 15px;
    overflow: hidden;
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: var(--shadow-sm);
}

.product-card:hover {
    transform: translateY(-8px);
    border-color: var(--gold);
    box-shadow: 0 15px 40px rgba(212, 175, 55, 0.25);
}

.product-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    transition: var(--transition-smooth);
}

.product-card:hover img {
    transform: scale(1.08);
}

.product-info {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.product-info h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--text-light);
}

.product-info p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    flex-grow: 1;
}

.price {
    color: var(--gold);
    font-weight: 700;
    font-size: 1.3rem;
    margin-bottom: 1rem;
}

.btn-add {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark-bg);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition-smooth);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
}

.btn-add:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
}

/* ======================== CART SIDEBAR ======================== */
.cart-sidebar {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 15px;
    padding: 2rem;
    height: fit-content;
    position: sticky;
    top: 100px;
    box-shadow: var(--shadow-lg);
}

@media (max-width: 1024px) {
    .cart-sidebar {
        position: static;
        top: auto;
    }
}

.cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.cart-header h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--text-light);
    margin: 0;
}

.btn-clear-cart {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 1.2rem;
    transition: var(--transition-smooth);
}

.btn-clear-cart:hover {
    color: var(--gold);
}

.cart-items-container {
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 1.5rem;
}

.cart-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.cart-item {
    background: rgba(212, 175, 55, 0.05);
    padding: 1rem;
    border-radius: 10px;
    border-left: 3px solid var(--gold);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.cart-item-name {
    flex-grow: 1;
}

.cart-item-name strong {
    display: block;
    color: var(--text-light);
    margin-bottom: 0.25rem;
}

.cart-item-details {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.cart-item-price {
    color: var(--gold);
    font-weight: 700;
    margin: 0 1rem;
}

.cart-item-qty-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-qty {
    width: 24px;
    height: 24px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    cursor: pointer;
    border-radius: 4px;
    font-size: 0.85rem;
    transition: var(--transition-smooth);
}

.btn-qty:hover {
    background: var(--gold);
    color: var(--dark-bg);
}

.btn-remove {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 1rem;
    transition: var(--transition-smooth);
}

.btn-remove:hover {
    color: #ff4444;
}

.empty-cart {
    color: var(--text-secondary);
    text-align: center;
    padding: 1rem;
    font-style: italic;
}

.divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 1.5rem 0;
}

.cart-summary {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
}

.summary-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: var(--text-secondary);
}

.summary-line.total {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--gold);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
}

/* ======================== CART ACTIONS ======================== */
.cart-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.btn-pay,
.btn-whatsapp {
    padding: 1rem;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
}

.btn-pay {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark-bg);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.btn-pay:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(212, 175, 55, 0.5);
}

.btn-pay:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn-whatsapp {
    background: transparent;
    color: var(--gold);
    border: 2px solid var(--gold);
}

.btn-whatsapp:hover {
    background: var(--hover-bg);
    transform: translateY(-2px);
}

.footer-note {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 1.5rem;
}
/* --- Styles de base (Mobile First & Centrage Global) --- */
.footer {
    padding: 40px 20px 20px;
    background-color: #ffffff; /* Ajuste selon ton design */
    text-align: center;        /* Centre tout le texte par défaut */
    font-family: sans-serif;
}

.footer-content {
    display: flex;
    flex-direction: column;    /* Empilement vertical sur mobile */
    gap: 30px;                 /* Espace entre les blocs */
    margin-bottom: 30px;
}

.footer-section h3 {
    margin-bottom: 15px;
    font-size: 1.2rem;
    color: #333;
}

.footer-section p {
    margin: 5px 0;
    line-height: 1.6;
    color: #666;
}

.footer-bottom {
    border-top: 1px solid #eee;
    padding-top: 20px;
    font-size: 0.9rem;
}

/* --- Adaptation pour Tablettes et Ordinateurs (Desktop) --- */
@media (min-width: 768px) {
    .footer-content {
        flex-direction: row;     /* Aligne en ligne sur grand écran */
        justify-content: center; /* Centre les blocs horizontalement */
        align-items: flex-start; /* Aligne les titres en haut */
        max-width: 1100px;
        margin-left: auto;
        margin-right: auto;
    }

    .footer-section {
        flex: 1;                 /* Donne la même largeur à chaque colonne */
        padding: 0 15px;
    }
}

/* ======================== QR CODE SECTION ======================== */
.qr-code-section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
}

.btn-qr-toggle {
    width: 100%;
    padding: 0.75rem;
    background: transparent;
    border: 2px solid var(--gold);
    color: var(--gold);
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition-smooth);
    font-size: 0.9rem;
}

.btn-qr-toggle:hover {
    background: var(--hover-bg);
}

.qr-code-container {
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: rgba(212, 175, 55, 0.05);
    border-radius: 12px;
    text-align: center;
    border: 1px solid var(--border-color);
    transition: var(--transition-smooth);
}

.qr-code-container.hidden {
    display: none;
}

#qrCodeContainer canvas {
    background: white;
    padding: 1rem;
    border-radius: 8px;
}

/* ======================== MODAL STYLES ======================== */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    animation: fadeIn 0.3s ease-out;
}

.modal.show {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background: var(--card-bg);
    padding: 2.5rem;
    border-radius: 20px;
    border: 1px solid var(--border-color);
    max-width: 500px;
    width: 90%;
    position: relative;
    box-shadow: var(--shadow-lg);
    animation: slideUp 0.4s ease-out;
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-smooth);
}

.modal-close:hover {
    color: var(--gold);
}

.payment-modal h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-light);
}

.payment-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
}

.payment-option {
    background: rgba(212, 175, 55, 0.05);
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--text); /* use theme text variable for readability */
}

.payment-option:hover {
    border-color: var(--gold);
    background: var(--hover-bg);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.2);
}

.payment-option-icon {
    font-size: 2rem;
}

.payment-option span {
    font-weight: 600;
    font-size: 0.95rem;
}

.payment-option small {
    color: var(--text-secondary);
    font-size: 0.75rem;
    text-align: center;
}

.payment-info {
    background: rgba(212, 175, 55, 0.05);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1.5rem;
}

.payment-info p {
    margin: 0.5rem 0;
}

.payment-info strong {
    color: var(--gold);
}

.info-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 1rem;
}

/* ======================== FLOATING ACTION BUTTON ======================== */
.whatsapp-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #25d366 0%, #20ba5c 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
    box-shadow: 0 12px 40px rgba(37, 211, 102, 0.4);
    z-index: 50;
    animation: bounce 2s infinite;
}

.whatsapp-float:hover {
    transform: scale(1.15) translateY(-5px);
    box-shadow: 0 15px 50px rgba(37, 211, 102, 0.6);
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

/* ======================== RESPONSIVE DESIGN ======================== */
@media (max-width: 768px) {
    .nav-links {
        gap: 1rem;
    }

    .hero-title {
        font-size: 2rem;
    }

    .hero-btns {
        flex-direction: column;
        /* border-radius: 40px; */
    }

    .btn-cta {
