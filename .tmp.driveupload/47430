    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
}

.breadcrumb a {
    color: var(--gold);
    text-decoration: none;
    transition: var(--transition-smooth);
}

.breadcrumb a:hover {
    color: var(--gold-light);
    text-decoration: underline;
}

.hero-menu-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: 1px;
    color: var(--text-light);
}

.hero-menu-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    font-weight: 300;
}

/* Section Headers */
.section-header {
    margin-bottom: 3rem;
    text-align: center;
}

.section-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    color: var(--text-light);
    margin-bottom: 0.75rem;
}

.section-header p {
    color: var(--text-secondary);
    font-size: 1rem;
}

/* Chef Specialty Section */
.chef-specialty-section {
    margin: 4rem 0;
}

.chef-specialty-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
}

.chef-specialty-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: var(--transition-smooth);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 2rem;
    position: relative;
}

.chef-specialty-card:hover {
    border-color: var(--gold);
    box-shadow: 0 20px 60px rgba(212, 175, 55, 0.3);
}

.specialty-badge {
    position: absolute;
    top: 2rem;
    left: 2rem;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark-bg);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    z-index: 5;
}

.badge-icon {
    font-size: 1.2rem;
}

.chef-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 15px;
    height: 500px;
}

.chef-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
}

.chef-specialty-card:hover .chef-image {
    transform: scale(1.05);
}

.image-overlay-chef {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.7) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    transition: var(--transition-smooth);
}

.chef-specialty-card:hover .image-overlay-chef {
    opacity: 1;
}

.image-overlay-chef .btn-cta {
    width: 100%;
}

.chef-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.chef-name {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--text-light);
    margin: 0;
}

.rating {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.stars {
    color: var(--gold);
    font-size: 1.2rem;
    letter-spacing: 2px;
}

.review-count {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.chef-description {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 1rem;
}

.chef-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.5rem;
    background: rgba(212, 175, 55, 0.05);
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

.detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.detail-label {
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

.detail-value {
    color: var(--text-light);
    font-size: 1.1rem;
    font-weight: 700;
}

.detail-value.price {
    color: var(--gold);
    font-size: 1.3rem;
}

.chef-ingredients {
    background: rgba(212, 175, 55, 0.08);
    padding: 1.5rem;
    border-radius: 12px;
    border-left: 4px solid var(--gold);
}

.chef-ingredients h4 {
    color: var(--gold);
    margin-bottom: 1rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.chef-ingredients ul {
    list-style: none;
    padding: 0;
}

.chef-ingredients li {
    color: var(--text-secondary);
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
}

.chef-ingredients li::before {
    content: '✓';
    color: var(--gold);
    font-weight: bold;
}

/* Daily Suggestions Section */
.daily-suggestions-section {
    margin: 5rem 0;
}

.suggestions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
}

.suggestion-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 15px;
    overflow: hidden;
    transition: var(--transition-smooth);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
}

.suggestion-card:hover {
    transform: translateY(-10px);
    border-color: var(--gold);
    box-shadow: 0 15px 40px rgba(212, 175, 55, 0.25);
}

.suggestion-image {
    position: relative;
    overflow: hidden;
    height: 250px;
}

.suggestion-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
}

.suggestion-card:hover .suggestion-image img {
    transform: scale(1.1);
}

.suggestion-label {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark-bg);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.suggestion-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.suggestion-content h4 {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: var(--text-light);
    margin-bottom: 0.5rem;
}

.suggestion-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    flex-grow: 1;
}

.suggestion-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
}

.suggestion-price {
    color: var(--gold);
    font-weight: 700;
    font-size: 1.1rem;
}

.btn-add-small {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
    color: var(--dark-bg);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    font-weight: bold;
    font-size: 1.2rem;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-add-small:hover {
    transform: scale(1.15);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.4);
}

/* Advantages Section */
.advantages-section {
    margin: 5rem 0;
    padding: 3rem 2rem;
    background: rgba(212, 175, 55, 0.05);
    border-radius: 20px;
    border: 1px solid var(--border-color);
}

.advantages-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    text-align: center;
    margin-bottom: 3rem;
    color: var(--text-light);
}

.advantages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
}

.advantage-card {
    text-align: center;
}

.advantage-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: block;
}

.advantage-card h3 {
    color: var(--gold);
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
}

.advantage-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.95rem;
}

/* CTA Section */
.cta-section {
    margin: 5rem 0;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.05) 100%);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    text-align: center;
}

.cta-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-light);
}

.cta-section p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2rem;
}

.cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

.cta-buttons .btn-cta {
    display: inline-block;
}

/* Footer */
.footer {
    background: rgba(15, 15, 15, 0.95);
    border-top: 1px solid var(--border-color);
    padding: 3rem 2rem 1rem;
    margin-top: 5rem;
}

.footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.footer-section h3 {
    color: var(--gold);
    margin-bottom: 1rem;
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
}

.footer-section p {
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.6;
}

.footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    color: #ffffff;
    font-size: 0.9rem;
}

/* Badge New */
.badge-new {
    position: relative;
    margin-right: 0.75rem;
}

/* Use ::before for badge to avoid conflict with ::after underline */
.badge-new::before {
    /* content: 'NEW'; */
    position: absolute;
    top: -8px;
    right: -12px;
    background: #D4AF37;
    color: var(--dark-bg);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 2px 5px;
    border-radius: 3px;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(0.95); }
}

/* Responsive Menu du Jour */
@media (max-width: 1024px) {
    .chef-specialty-card {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 1.5rem;
    }

    .chef-image-wrapper {
        height: 350px;
    }

    .specialty-badge {
        top: 1rem;
        left: 1rem;
    }

    .suggestions-grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
}

@media (max-width: 768px) {
    .hero-menu-jour {
        height: 50vh;
    }

    .chef-specialty-card {
        padding: 1rem;
    }

    .chef-details {
        grid-template-columns: 1fr;
    }

    .suggestions-grid {
        grid-template-columns: 1fr;
    }

    .cta-buttons {
        flex-direction: column;
    }

    .cta-buttons .btn-cta {
        width: 100%;
    }

    .advantages-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 480px) {
    .hero-menu-jour {
        height: 40vh;
    }

    .hero-menu-title {
        font-size: 1.5rem;
    }

    .section-header h2 {
        font-size: 1.5rem;
    }

    .chef-name {
        font-size: 1.3rem;
    }

    .advantages-grid {
        grid-template-columns: 1fr;
    }

    .specialty-badge {
        font-size: 0.7rem;
        padding: 0.5rem 1rem;
    }

    .chef-image-wrapper {
        height: 250px;
    }

    .footer-content {
        grid-template-columns: 1fr;
    }

    .logo p {
        text-align: center;
    }
}

/* ======================== FAQ PAGE ======================== */

.faq-container {
    max-width: 900px;
    margin: 3rem auto;
}

.hero-simple {
    height: 50vh;
    min-height: 400px;
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('img/baniere.jpeg') center / cover no-repeat fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.hero-simple .hero-content {
    z-index: 2;
}

.faq-section {
    padding: 3rem 2rem;
}

.section-header {
    text-align: center;
    margin-bottom: 3rem;
}

.section-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: var(--gold);
    margin-bottom: 0.5rem;
}

.section-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
}

.accordion-group {
    margin-bottom: 2rem;
}

.accordion-group:last-child {
    margin-bottom: 0;
}

.accordion-group h3 {
    font-size: 1.3rem;
    color: var(--gold);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.accordion {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 1rem;
    overflow: hidden;
    transition: var(--transition-smooth);
}

.accordion:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow-sm);
}

.accordion.active {
    box-shadow: 0 0 20px rgba(198, 142, 23, 0.2);
}

.accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.2rem;
    background: var(--bg-card);
    border: none;
    color: var(--text);
    cursor: pointer;
    text-align: left;
    font-size: 1rem;
    font-weight: 600;
    transition: var(--transition-smooth);
}

.accordion-header:hover {
    background: var(--hover);
    color: var(--gold);
}

.accordion.active .accordion-header {
    background: var(--hover);
    color: var(--gold);
}

.accordion-icon {
    color: var(--gold);
    font-size: 1.5rem;
    font-weight: bold;
    transition: var(--transition-smooth);
}

.accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
    background: rgba(212, 175, 55, 0.03);
    padding: 0 1.2rem 0 1.2rem;
}

.accordion.active .accordion-content {
    max-height: 1000px;
    padding: 1.2rem;
}

.accordion-content p {
    color: var(--text-secondary);
    /* line-height: 1.8; */
    margin-bottom: 1rem;
    margin: auto;
}

.accordion-content ul {
    margin: 1rem 0;
    margin-left: 2rem;
    color: var(--text-secondary);
    line-height: 1.8;
}

.accordion-content li {
    margin-bottom: 0.5rem;
}

.accordion-content code {
    background: rgba(212, 175, 55, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: var(--gold);
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

.quick-contact-section {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.05) 100%);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 4rem 2rem;
    text-align: center;
    margin-top: 4rem;
}

.quick-contact-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--text);
    margin-bottom: 0.5rem;
}

.quick-contact-content p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2rem;
}

.quick-contact-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

/* ======================== CONTACT PAGE ======================== */

/* ================================
   CONTACT SECTION
================================ */
.contact-section{
    position:relative;
    z-index:1;
    max-width:1200px;
    margin:auto;
    padding:80px 20px;
    display: grid;
    grid-template-columns: 1fr;
}

.section-title{
    text-align:center;
    font-family:'Playfair Display',serif;
    font-size:2.6rem;
    margin-bottom:60px;
    color: var(--gold);
}

/* GRID */
.contact-container{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

/* CARD */
.contact-card{
    /* background:var(--bg-card); */
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:30px;
    box-shadow:var(--shadow);
    transition:var(--transition);
}

.contact-card:hover{
    transform:translateY(-8px);
}

.card-title{
    font-size:1.4rem;
    margin-bottom:20px;
}

/* MAP */
.map-wrapper{
    overflow:hidden;
    border-radius:12px;
}

.map-wrapper iframe{
    width:100%;
    height:300px;
    border:0;
}

/* ================================
   FORM
================================ */
.form-group{
    margin-bottom:18px;
    border-color: black;
}

input,
textarea{
    width:100%;
    background:transparent;
    border:1px solid var(--border);
    padding:14px 16px;
    border-radius:10px;
    color:var(--text);
    font-size:.95rem;
    transition:var(--transition);
}

input:focus,
textarea:focus{
    outline:none;
    border-color:var(--gold);
    box-shadow:0 0 0 2px rgba(200,155,60,.15);
}

textarea{
    resize:none;
}

.btn-submit{
    width:100%;
    border:none;
    /* background:linear-gradient(135deg,var(--gold),var(--gold-soft)); */
    background: var(--gold);
    padding:15px;
    font-weight:600;
    border-radius:12px;
    cursor:pointer;
    transition:var(--transition);
}

.btn-submit:hover{
    transform:translateY(-3px);
    /* box-shadow:0 10px 20px rgba(200,155,60,.35); */
    color: var(--gold-light);
    background-color: white;
}

/* Responsive pour contact */
@media (max-width: 768px) {
    .contact-container {
        grid-template-columns: 1fr;
    }
}

.form-group {
    display: flex;
    flex-direction: column;
} 

.form-group label {
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
} 

 .form-group input,
.form-group select,
.form-group textarea {
    background: rgba(212, 175, 55, 0.05);
    border: 1px solid var(--border);
    color: var(--gold);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    transition: var(--transition-smooth);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    /* color: #000; */
    color: var(--gold-light);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(212, 175, 55, 0.08);
    box-shadow: 0 0 10px rgba(198, 142, 23, 0.2);
}

.form-group textarea {
    resize: vertical;
    min-height: 120px;
    font-size: 0.95rem;
}

/* ================================
   RESPONSIVE
================================ */
@media(max-width:900px){

    .nav-links{
        position:absolute;
        top:80px;
        right:0;
        background:var(--bg-card);
        flex-direction:column;
        width:260px;
        padding:25px;
        transform:translateX(100%);
        transition:var(--transition);
        border-left:1px solid var(--border);
    }

    .nav-links.active{
        transform:translateX(0);
    }
     }
     @keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.contact-card{
    animation:fadeUp .7s ease both;
}

