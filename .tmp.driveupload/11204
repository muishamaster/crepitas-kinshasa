    <!-- Section Hero Simple pour Contact -->
    <header class="hero-simple">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">Contactez-Nous</h1>
            <p class="hero-description">Nous serions ravi de vous entendre</p>
        </div>
    </header>

    <main class="main-container contact-container">
        <section class="contact-section">
            <!-- Formulaire de Contact -->
            <div class="contact-form-wrapper">
                <div class="form-header">
                    <h2>Envoyez-nous un Message</h2>
                    <p>Remplissez le formulaire ci-dessous et nous vous répondrons dans les 24 heures</p>
                </div>

                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label for="name">Votre Nom *</label>
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            placeholder="Jean Dupont"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="email">Votre Email *</label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            placeholder="vous@exemple.com"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="phone">Numéro de Téléphone / WhatsApp *</label>
                        <input 
                            type="tel" 
                            id="phone" 
                            name="phone" 
                            placeholder="+243 977 970 594"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="subject">Sujet *</label>
                        <select id="subject" name="subject" required>
                            <option value="">-- Sélectionnez un sujet --</option>
                            <option value="commande">Question sur une Commande</option>
                            <option value="livraison">Problème de Livraison</option>
                            <option value="paiement">Problème de Paiement</option>
                            <option value="allergie">Question sur les Allergènes</option>
                            <option value="partenariat">Demande de Partenariat</option>
                            <option value="emploi">Offre d'Emploi</option>
                            <option value="autre">Autre</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message">Message *</label>
                        <textarea 
                            id="message" 
                            name="message" 
                            placeholder="Votre message ici..."
                            rows="6"
                            required
                        ></textarea>
                    </div>

                    <div class="form-group form-checkbox">
                        <input type="checkbox" id="consent" name="consent" required>
                        <label for="consent">
                            J'accepte de recevoir des communications marketing
                        </label>
                    </div>

                    <button type="submit" class="btn-submit">
                        Envoyer le Message
                    </button>
                    <p class="form-notice">
                        * Champs obligatoires
                    </p>
                </form>

                <div class="form-success hidden" id="formSuccess">
                    <div class="success-icon">✓</div>
                    <h3>Message Envoyé !</h3>
                    <p>Merci de nous avoir contactés. Nous vous répondrons dans les 24 heures.</p>
                    <button class="btn-cta btn-cta-secondary" onclick="location.href='./index.html'">
                        Retour à l'Accueil
                    </button>
                </div>
            </div>

            <!-- Informations de Contact & Map -->
            <div class="contact-info-wrapper">
                <!-- Options de Contact -->
                <div class="contact-methods">
                    <div class="contact-method">
                        <div class="method-icon">📱</div>
                        <h3>WhatsApp Direct</h3>
                        <p>Le plus rapide pour nous joindre</p>
                        <a href="https://wa.me/243977970594" target="_blank" class="contact-link">
                            +243 977 970 594
                        </a>
                    </div>

                    <div class="contact-method">
                        <div class="method-icon">📍</div>
                        <h3>Notre Localisation</h3>
                        <p>Laiko (Kinshasa)</p>
                        <p class="address-text">Près du rond-point Victoire Lumumbamemba</p>
                    </div>

                    <div class="contact-method">
                        <div class="method-icon">🕐</div>
                        <h3>Horaires d'Ouverture</h3>
                        <div class="hours-list">
                            <p><strong>Lun-Ven:</strong> 11h00 - 23h00</p>
                            <p><strong>Sam-Dim:</strong> 10h00 - 00h00</p>
                        </div>
                    </div>

                    <div class="contact-method">
                        <div class="method-icon">📧</div>
                        <h3>Par Email</h3>
                        <p>(Réponse sous 48h)</p>
                        <a href="mailto:info@crepitas.cd" class="contact-link">
                            info@crepitas.cd
                        </a>
                    </div>
                </div>

                <!-- Section Google Maps (placeholder) -->
                <div class="map-section">
                    <h3>Nous Trouver</h3>
                    <div class="map-placeholder" id="mapContainer">
                        <div class="map-placeholder-content">
                            <div class="map-icon">📍</div>
                            <p><strong>Crepitas Kinshasa</strong></p>
                            <p>Laiko, Kinshasa, DRC</p>
                            <a href="https://maps.google.com/?q=Kinshasa,+Laiko" target="_blank" class="btn-cta btn-cta-secondary btn-sm">
                                Voir sur Google Maps
                            </a>
                        </div>
                    </div>
                    <!-- La Google Maps sera intégrée ici ultérieurement -->
                    <!-- 
                    <iframe src="https://www.google.com/maps/embed?pb=..." style="width:100%; height:300px; border:none; border-radius:12px;" allowfullscreen="" loading="lazy"></iframe>
                    -->
                </div>
            </div>
        </section>

        <!-- Section FAQ Rapide -->
        <section class="faq-quick-section">
            <h2>Questions avant de nous contacter ?</h2>
            <p>Consultez la <a href="./faq.html">page FAQ</a> pour les réponses courantes</p>
        </section>
    </main>

    <!-- Floating Action Button WhatsApp -->
    <a href="https://wa.me/243977970594" target="_blank" class="whatsapp-float" title="Contactez-nous sur WhatsApp">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378c-3.055 2.364-3.905 6.75-1.897 10.391 1.672 2.904 5.291 3.118 8.632 3.118h.46a9.75 9.75 0 003.464-.6l3.585 1.241a.18.18 0 00.248-.204l-1.081-3.93a9.8 9.8 0 001.175-5.621c-.001-5.487-4.144-9.95-9.451-9.95"></path>
