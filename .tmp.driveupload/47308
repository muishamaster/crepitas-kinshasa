    <main class="main-container">
        <!-- Section Spécialité du Chef -->
        <section class="chef-specialty-section">
            <div class="section-header">
                <h2>La Spécialité du Chef Aujourd'hui</h2>
                <p>Une création unique et délicieuse à découvrir en priorité</p>
            </div>

            <div class="chef-specialty-container">
                <div class="chef-specialty-card">
                    <!-- Badge Spécialité -->
                    <div class="specialty-badge">
                        <span class="badge-icon">⭐</span>
                        <span class="badge-text">Spécialité</span>
                    </div>

                    <!-- Image agrandie -->
                    <div class="chef-image-wrapper">
                            <img src="./img/mil10.jpg" 
                                alt="Spécialité du Chef - Crêpe du Chef" 
                                class="chef-image" onerror="this.onerror=null;this.src='./img/placeholder.jpg'">
                        <div class="image-overlay-chef">
                            <button class="btn-cta btn-cta-primary" onclick="addToCartFromChef()" title="Ajouter au panier">
                                AJOUTER AU PANIER
                            </button>
                        </div>
                    </div>

                    <!-- Contenu -->
                    <div class="chef-content">
                        <h3 class="chef-name">Crepitas Signature</h3>
                        <div class="rating">
                            <span class="stars">★★★★★</span>
                            <span class="review-count">(48 avis)</span>
                        </div>
                        <p class="chef-description">
                            Notre chef vous présente sa création maison: une crêpe signature aux textures et saveurs uniques,
                            préparée avec des ingrédients premium et une touche caramélisée pour sublimer chaque bouchée.
                        </p>
                        <div class="chef-details">
                            <div class="detail-item">
                                <span class="detail-label">Prix</span>
                                <span class="detail-value price">25 000 FC</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Temps de préparation</span>
                                <span class="detail-value">25 minutes</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Portions</span>
                                <span class="detail-value">1-2 personnes</span>
                            </div>
                        </div>
                        <div class="chef-ingredients">
                            <h4>Ingrédients vedettes</h4>
                            <ul>
                                <li>Pâte fine et croustillante</li>
                                <li>Garnitures premium (chocolat, fruits, fromage)</li>
                                <li>Touche caramélisée</li>
                                <li>Garniture secrète du chef</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

