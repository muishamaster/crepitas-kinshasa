    <script>
        // Fonction pour ajouter au panier depuis la spécialité du chef
        function addToCartFromChef() {
            if (typeof cartManager !== 'undefined') {
                cartManager.addToCart(11, 'Crepitas Signature', 25000, 1);
            } else {
                alert('Crepitas Signature ajouté au panier!');
            }
        }

        // Fonction générique pour ajouter au panier
        function addToCart(id, name, price) {
            if (typeof cartManager !== 'undefined') {
                cartManager.addToCart(id, name, price, 1);
            } else {
                alert(name + ' ajouté au panier!');
            }
        }

        // Scroll au panier
        function scrollToCart() {
            window.location.href = 'menu.html#cart';
        }

        // Initialiser le panier au chargement
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof cartManager !== 'undefined' && typeof cartManager.init === 'function') {
                cartManager.init();
            }
        });
    </script>
