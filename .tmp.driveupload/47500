        function testPayment() {
            alert('Le système de paiement est intégré.\n\nPour tester:\n1. Aller sur menu.html\n2. Ajouter des produits\n3. Cliquer "PASSER LA COMMANDE"\n4. Choisir mode paiement (Mobile Money ou WhatsApp)');
        }

        function openPages() {
            const pages = [
                { name: 'Accueil', url: 'index.html' },
                { name: 'Menu', url: 'menu.html' },
                { name: 'Menu du Jour', url: 'menu-du-jour.html' },
                { name: 'Entrées', url: 'entrees.html' },
                { name: 'Plats', url: 'plats.html' },
                { name: 'Desserts', url: 'desserts.html' },
                { name: 'Boissons', url: 'boissons.html' }
            ];

            let html = 'Ouvrir une page:\n\n';
            pages.forEach(p => {
                html += `${p.name}: ${p.url}\n`;
            });
            
            const selected = prompt(html);
            if (selected) {
                const page = pages.find(p => p.url.includes(selected.toLowerCase()));
                if (page) window.open(page.url, '_blank');
            }
        }

        // Test au chargement
